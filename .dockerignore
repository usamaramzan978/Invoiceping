# -----------------------------
# Node & Composer dependencies
# -----------------------------
node_modules
vendor

# -----------------------------
# Laravel storage & cache (recreated inside container)
# -----------------------------
storage/*.key
storage/*.log
storage/framework/cache/*
storage/framework/sessions/*
storage/framework/views/*
bootstrap/cache/*.php

# -----------------------------
# Environment files (never copy secrets)
# -----------------------------
.env
.env.local
.env.*.local

# -----------------------------
# Logs
# -----------------------------
*.log
storage/logs/

# -----------------------------
# Docker-related files (not needed in build context)
# -----------------------------
Dockerfile
docker-compose.yml
.dockerignore
docker/

# -----------------------------
# Git / version control
# -----------------------------
.git
.gitignore
.gitattributes


# -----------------------------
# CI/CD
# -----------------------------
.github
.gitlab-ci.yml
.travis.yml

# -----------------------------
# Editor / IDE
# -----------------------------
.vscode
.idea
*.swp
*.swo
*~
.DS_Store

# -----------------------------
# Node build artifacts (rebuild inside container)
# -----------------------------
public/build
npm-debug.log
yarn-error.log

# -----------------------------
# Temporary
# -----------------------------
tmp/
temp/
*.tmp

# -----------------------------
# Development
# -----------------------------
README.md
CHANGELOG.md
LICENSE
.editorconfig
